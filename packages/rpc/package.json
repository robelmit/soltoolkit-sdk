{
  "name": "@soltoolkit/rpc",
  "version": "0.1.0",
  "description": "A small Solana JSON-RPC client with pacing and retries, plus base58 and program-derived addresses. No dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robelmit/soltoolkit-sdk.git",
    "directory": "packages/rpc"
  },
  "homepage": "https://github.com/robelmit/soltoolkit-sdk/tree/main/packages/rpc#readme",
  "bugs": {
    "url": "https://github.com/robelmit/soltoolkit-sdk/issues"
  },
  "keywords": [
    "solana",
    "rpc",
    "json-rpc",
    "rate-limit"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^22.10.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
